# Copie este arquivo para .env e preencha os valores obrigatórios
# cp .env.example .env

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=airflow
POSTGRES_PASSWORD=               # OBRIGATÓRIO
POSTGRES_DB=airflow

# ── Airflow — segurança ───────────────────────────────────────────────────────
# Gere a Fernet Key com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=       # OBRIGATÓRIO

# Qualquer string aleatória segura (min. 16 chars)
AIRFLOW__WEBSERVER__SECRET_KEY=  # OBRIGATÓRIO

# ── Airflow — usuário admin ───────────────────────────────────────────────────
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=      # OBRIGATÓRIO
